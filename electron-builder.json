{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.shridhar396.astralyr",
  "productName": "Astralyr",
  "artifactName": "${productName}-Setup-${version}.${ext}",
  "directories": {
    "output": "release",
    "buildResources": "assets/branding"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "assets/branding/**/*"
  ],
  "publish": {
    "provider": "github",
    "owner": "Shridhar396",
    "repo": "Astralyr"
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "assets/branding/astralyr-icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Astralyr",
    "artifactName": "${productName}-Setup-${version}.${ext}"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "assets/branding/icon.icns",
    "category": "public.app-category.music"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      }
    ],
    "icon": "assets/branding/astralyr-icon.png",
    "category": "AudioVideo"
  }
}

